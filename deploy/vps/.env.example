# Hæstore API — production environment for deploy/vps/compose.yml.
# Copy to deploy/vps/.env (never committed) and fill in. See docs/DEPLOYMENT.md.
#
# Generate every secret below with:  openssl rand -hex 32
# Hex on purpose: REDIS_PASSWORD is spliced into a URL, where + / = would break it.

# ---- Compose only ---------------------------------------------------------
# Read by compose.yml, which also builds REDIS_URL, MEILISEARCH_HOST and
# MEILISEARCH_API_KEY from them — do not set those three here.
REDIS_PASSWORD=
MEILI_MASTER_KEY=

# ---- Runtime --------------------------------------------------------------
LOG_LEVEL=info
# This API's public address, and the storefront's. Different origins by design (ADR-001).
PUBLIC_URL=https://api.example.com
WEB_URL=https://shop.example.com
# The storefront's origin. Every non-GET request must present it (the CSRF defence).
ALLOWED_ORIGINS=https://shop.example.com

# ---- MongoDB (external) ---------------------------------------------------
# Must be a replica set (checkout's transactions, the search outbox's change streams).
# A hosted cluster such as Atlas is one. Do NOT add directConnection=true: that is a
# workaround for the local development replica set only, and against a real cluster it
# pins the driver to one member. The cluster's IP allowlist must include this VPS.
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/haestore?retryWrites=true&w=majority

# ---- Auth -----------------------------------------------------------------
OTP_PEPPER=
GUEST_COOKIE_SECRET=
# The same value as the storefront Worker's secret (npx wrangler secret put
# PROXY_SHARED_SECRET). Without it every shopper shares one sign-in throttle bucket.
PROXY_SHARED_SECRET=
# Granted the admin role at sign-in. Comma-separated.
ADMIN_EMAILS=

# ---- Mail (Gmail API over 443; see docs/GMAIL-API-MIGRATION-NOTE.md) --------
MAIL_DRIVER=gmail-api
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REFRESH_TOKEN=
MAIL_REDIRECT_URI=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hæstore

# ---- Media ----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=haestore

# ---- Payments (test mode only — live keys are refused at boot, ADR-016) ---------
STRIPE_SECRET_KEY=sk_test_
# Optional: the reconcile path confirms payments without a webhook. Set it only if a
# test-mode webhook is registered at https://api.example.com/api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The only accepted value.
PAYPAL_ENV=sandbox
# Optional, as above, for a sandbox webhook at /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=

# ---- Jobs -----------------------------------------------------------------
CHECKOUT_RESERVATION_MINUTES=30
ORDER_JOBS_ENABLED=true
SEARCH_INDEXING_ENABLED=true

# ---- Seeding (read only by the one-off seed service) -----------------------
# Reports each photograph's download to Unsplash, as its guidelines require. The
# ledger of what was reported lives in the seed's unsplash-ledger volume.
UNSPLASH_ACCESS_KEY=
